{
  // El Worker de Cloudflare: sirve la web y hace de mesa donde los dos
  // jugadores se encuentran.
  //
  // La mesa vive aqui y no en Supabase a proposito: encontrarse es justo lo
  // que tiene que funcionar en el segundo en que el amigo esta esperando con
  // las cartas en la mano, y un proyecto gratis de Supabase se pausa a los
  // siete dias. Cloudflare no se pausa nunca.
  //
  // Y en cuanto los dos se encuentran, el video y los contadores van
  // DIRECTOS de un navegador al otro. Esto se queda parado sin gastar.

  "$schema": "./node_modules/wrangler/config-schema.json",

  // El nombre es la direccion: magic-mesa.duelo.workers.dev
  "name": "magic-mesa",

  "main": "worker/index.ts",

  // Fija como se comporta el entorno de Cloudflare. Se deja quieta: subirla
  // puede cambiar el comportamiento de cosas que ya funcionan.
  "compatibility_date": "2026-10-26",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",

    // Cuando se pida una direccion que no es un archivo, devolver el
    // index.html en vez de un error. Hace falta en cuanto la web tenga
    // direcciones por dentro, como /mesa/1234.
    "not_found_handling": "single-page-application",

    // Sin esto, lo de /api/ se lo comeria el index.html y el Worker no
    // llegaria a ejecutarse nunca.
    "run_worker_first": ["/api/*"]
  },

  "durable_objects": {
    "bindings": [{ "name": "MESAS", "class_name": "Mesa" }]
  },

  // `new_sqlite_classes` y no `new_classes`: en el plan gratis los Durable
  // Objects solo existen con almacenamiento SQLite.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Mesa"] }],

  "observability": { "enabled": true }
}
